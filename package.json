{
  "name": "aile.sh",
  "version": "1.2.0",
  "description": "Command-line client for aile.sh — lend spare AI capacity from a machine you own, or choose which lender serves your requests.",
  "type": "module",
  "bin": {
    "aile": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.js",
    "dev": "bun run src/cli/index.js",
    "test": "bun test --isolate",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "aile",
    "ai",
    "llm",
    "inference",
    "marketplace",
    "relay",
    "openai",
    "anthropic",
    "cli",
    "solana",
    "usdc"
  ],
  "homepage": "https://aile.sh/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailelabs/aile.sh.git"
  },
  "bugs": {
    "url": "https://github.com/ailelabs/aile.sh/issues"
  },
  "author": "Aile Labs",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@scure/bip39": "^2.4.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.3.0",
    "@x402/core": "^2.27.0",
    "@x402/svm": "^2.27.0",
    "jsqr": "^1.4.0",
    "node-forge": "^1.4.0",
    "uqr": "^0.1.3"
  }
}
